# ============================================
# EXAMPLE: Civic Dates Microservice - Neon Environment Variables
# ============================================
# Copy this file to .env and replace with your Neon credentials

# ============ DATABASE (NEON) ============
# Neon format: postgresql://user:password@ep-xxxxx.neon.tech/dbname
# Example: postgresql://neonuser:password@ep-clean-lab-123.neon.tech/civic_dates

# For R2DBC URL in application-prod.yml, extract:
# - VPC_DB_HOST: ep-clean-lab-123.neon.tech
# - VPC_DB_USERNAME: neonuser
# - VPC_DB_PASSWORD: your_password
# - VPC_DB_NAME: civic_dates
# - VPC_DB_SCHEMA: public (default for Neon)

VPC_DB_HOST=ep-xxxxx.neon.tech
VPC_DB_USERNAME=neonuser
VPC_DB_PASSWORD=your_neon_password
VPC_DB_NAME=civic_dates
VPC_DB_SCHEMA=public

# ============ KEYCLOAK / JWT ============
KEYCLOAK_ISSUER_URI=https://lab.vallegrande.edu.pe/keycloak/realms/sigei
KEYCLOAK_JWK_SET_URI=https://lab.vallegrande.edu.pe/keycloak/realms/sigei/protocol/openid-connect/certs

# ============ RABBITMQ ============
RABBITMQ_HOST=rabbitmq.example.com
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ============ INSTITUTION SERVICE ============
VPC_INSTITUTION_SERVICE_URL=http://institution-ms:8080
INSTITUTION_MOCK_ENABLED=false

# ============ SERVER ============
SERVER_PORT=9085
SPRING_PROFILES_ACTIVE=prod
